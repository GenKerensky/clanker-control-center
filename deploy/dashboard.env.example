# chmod 600 this file at ~/.config/tokscale/dashboard.env
TOKSCALE_AUTH=off
# TOKSCALE_AUTH=github
# TOKSCALE_PUBLIC_URL=http://127.0.0.1:3333
# TOKSCALE_GITHUB_CLIENT_ID=
# TOKSCALE_GITHUB_CLIENT_SECRET=
# TOKSCALE_GITHUB_USERS=yourlogin
# TOKSCALE_SESSION_SECRET=replace-with-32-plus-random-bytes
# TOKSCALE_INTERNAL_TOKEN=
# TOKSCALE_WRITE_TUI_CACHE=1
# TOKSCALE_JOB_TIMEOUT_MS=300000
